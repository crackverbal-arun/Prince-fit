# Local: file:local.db   Production: libsql://<db>.turso.io
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=
# openssl rand -base64 32
SESSION_SECRET=change-me-to-a-long-random-string
# Prince's login (used by `npm run seed`)
TRAINER_NAME=Prince
TRAINER_PHONE=9999999999
TRAINER_PASSWORD=change-me
# Any long random phrase; you type it once on /setup
SETUP_KEY=

# --- Automatic WhatsApp reminders (optional) ---
# Without these, reminders/reschedules/cancellations use one-tap WhatsApp buttons instead.
# From Meta Business → WhatsApp → API Setup (use a permanent System User token).
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template names and language (see README)
WHATSAPP_TEMPLATE_REMINDER=session_reminder
WHATSAPP_TEMPLATE_UPDATE=session_update
WHATSAPP_TEMPLATE_LANG=en
# Protects /api/cron/reminders; Vercel Cron sends it automatically. Any long random string.
CRON_SECRET=
